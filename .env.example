# ==============================================================================
# 环境变量模板
# 使用方式：复制此文件为 .env，修改为实际值
#   cp .env.example .env
# ==============================================================================

# MinIO（Milvus 对象存储后端）
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Grafana 管理员账户
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<your-secure-password>
